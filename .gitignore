# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Next.js build output & caches
/.next/
/out/
next-env.d.ts

# Production builds
/dist/
/build/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files & Secrets (exclude local secrets, keep .env.example)
.env
.env.local
.env.*.local
!.env.example

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Temporary / Legacy / Reference dumps
full-code.txt
import-report.md
folder-structure.txt
reference/

# System files
.DS_Store
*.pem

# Local media uploads (runtime uploads from admin testing & local dev)
/uploads/*
!/uploads/.gitkeep

# Runtime / Sensitive JSON state inside data/seed (preserve seed data, ignore live sessions/logs/orders)
/data/seed/sessions.json
/data/seed/order-share-links.json
/data/seed/audit-logs.json
/data/seed/orders.json

