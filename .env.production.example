# ===============================================================
# Persian Honey Website — Production Environment Configuration
# Save this file as .env.production on your production server.
# ===============================================================

NODE_ENV="production"
PORT=3000

# Public Production Domain (include https://)
SITE_URL="https://babakhorram.com"

# PostgreSQL Production Connection String
# If using docker-compose.prod.yml, this is wired automatically.
DATABASE_URL="postgresql://honey_admin:ChangeMeSecurePassword123!@localhost:5432/honey_prod?schema=public"

# Database credentials (if using docker-compose.prod.yml)
POSTGRES_USER="honey_admin"
POSTGRES_PASSWORD="ChangeMeSecurePassword123!"
POSTGRES_DB="honey_prod"

# Persistent Directory for Media Uploads
UPLOAD_DIR="/app/uploads"

# ===============================================================
# Cryptographic Secrets (CRITICAL: MUST BE UNIQUE & AT LEAST 32 CHARACTERS)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===============================================================
ORDER_LINK_SECRET=""
BETTER_AUTH_SECRET=""

# ===============================================================
# Instant Order Notification Bot Credentials (Optional)
# ===============================================================
# Bale Bot Token (from @BotFather in Bale) & Admin Chat ID
BALE_BOT_TOKEN=""
BALE_CHAT_ID=""

# Eitaa Bot Token (from https://eitaayar.ir) & Admin Chat ID
EITAA_BOT_TOKEN=""
EITAA_CHAT_ID=""

# Telegram Bot Token (from @BotFather in Telegram) & Admin Chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

