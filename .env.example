# ==========================================
# Persian Honey Project Environment
# ==========================================

# Node environment (development, test, production)
NODE_ENV="development"

# Server Port
PORT=3000

# PostgreSQL Connection String (neutral db name: honey_dev; see docker-compose.dev.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/honey_dev?schema=public"

# Public Site Canonical URL
SITE_URL="http://localhost:3000"

# Local Storage Directory for Media Uploads (processed by sharp)
UPLOAD_DIR="./uploads"

# 32+ character random string for AES-256-GCM encryption of temporary order share links
# Required in production; optional in local development
ORDER_LINK_SECRET="dev-secret-key-32-chars-minimum-length-for-aes-gcm!"

# Secret key for Better Auth session signing & cryptographic operations (min 16 chars)
BETTER_AUTH_SECRET="development-better-auth-secret-key-32-chars-long!"

# ==========================================
# Instant Admin Order Notifier (Eitaa, Bale, Telegram)
# Server-side webhook credentials for instant order notification upon checkout
# ==========================================
# Eitaa Bot Token (from https://eitaayar.ir) & Admin Chat ID
EITAA_BOT_TOKEN=""
EITAA_CHAT_ID=""

# Bale Bot Token (from @BotFather in Bale) & Admin Chat ID
BALE_BOT_TOKEN=""
BALE_CHAT_ID=""

# Telegram Bot Token (from @BotFather in Telegram) & Admin Chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ==========================================
# Placeholders for future phases (S3, Maps)
# ==========================================
# OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# STORAGE_PROVIDER="local" # "local" or "s3"

