@echo off
chcp 65001 >nul
echo ========================================================
echo  نصب و راه‌اندازی اولیه وب‌سایت عسل باباخُرم
echo ========================================================
echo.

echo [1/3] در حال نصب وابستگی‌های پروژه (pnpm install)...
call pnpm install
if %errorlevel% neq 0 (
    echo [خطا] در نصب پکیج‌ها خطایی رخ داد. لطفا از نصب بودن Node.js و pnpm اطمینان حاصل فرمایید.
    pause
    exit /b %errorlevel%
)

echo.
echo [2/3] در حال ساخت ساختار و جداول دیتابیس (prisma db push)...
call pnpm exec prisma db push
if %errorlevel% neq 0 (
    echo.
    echo =========================================================================
    echo [خطا در اتصال به دیتابیس]
    echo ارتباط با PostgreSQL برقرار نشد.
    echo لطفا مطمئن شوید سرویس PostgreSQL روی سیستم در حال اجراست و دیتابیس honey_prod ساخته شده است.
    echo راهنمای کامل در فایل POSTGRES-SETUP-GUIDE.md قرار دارد.
    echo =========================================================================
    pause
    exit /b %errorlevel%
)

echo.
echo [3/3] در حال بارگذاری اطلاعات اولیه محصولات، تنظیمات و مقالات...
call node scripts/seed-db.mjs

echo.
echo ========================================================
echo  راه‌اندازی با موفقیت انجام شد!
echo  اکنون می‌توانید با دابل کلیک روی 2-start-dev.bat سایت را باز کنید.
echo ========================================================
pause
